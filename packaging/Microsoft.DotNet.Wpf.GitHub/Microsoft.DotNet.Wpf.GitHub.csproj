<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>c847934a-828c-4ebb-a004-b0e97c8313f4</ProjectGuid>
    
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PackageName>LibreWPF.Transport$(TransportPackageNameSuffix)</PackageName>
    <AssemblyName>$(PackageName)</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.42</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>LibreWPF transport package for the portable managed presentation assemblies from the ProGPU port.</PackageDescription>
    <PackageReleaseNotes>Consumes ProGPU preview.52 with the portable WPF window-icon contract and adds PE application-icon fallback, modifier-aware managed text fallback, and safe child-window close disposal; retains WebGPU adapter-selection diagnostics, exact transformed and shader-backed stroke replay, bounded render-resource ownership, static-frame render suppression, nonactivating window state, settled popup placement, alpha-capable X11 transparent windows, and native Cocoa popups.</PackageReleaseNotes>
    <PackageTags>librewpf;progpu;xaml;themes;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackagingContent Include="README.md" SubFolder="root" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
