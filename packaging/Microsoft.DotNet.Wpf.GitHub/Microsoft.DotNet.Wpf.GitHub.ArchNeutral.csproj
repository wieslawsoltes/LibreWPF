<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>9a7e395b-e859-40e2-809d-efb72cf3a2ee</ProjectGuid>
    
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PackageName>LibreWPF.Transport$(TransportPackageNameSuffix)</PackageName>
    <AssemblyName>$(PackageName)</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.42</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>LibreWPF transport package with portable managed presentation assemblies, references, themes, XAML build tasks, and runtime metadata.</PackageDescription>
    <PackageReleaseNotes>Consumes ProGPU preview.50 with the portable WPF window-icon contract and adds PE application-icon fallback, modifier-aware managed text fallback, and safe child-window close disposal; retains WebGPU adapter-selection diagnostics, exact transformed and shader-backed stroke replay, bounded render-resource ownership, static-frame render suppression, nonactivating window state, settled popup placement, alpha-capable X11 transparent windows, and native Cocoa popups.</PackageReleaseNotes>
    <PackageTags>librewpf;progpu;xaml;themes;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeAssembliesInArchNeutralPackage>true</IncludeAssembliesInArchNeutralPackage>
    <PlatformIndependentPackage>true</PlatformIndependentPackage>
    <LibreWpfWindowsDesktopRuntimeVersion Condition="'$(LibreWpfWindowsDesktopRuntimeVersion)' == ''">$(ProGpuWpfNet10SupportPackageVersion)</LibreWpfWindowsDesktopRuntimeVersion>
    <LibreWpfWindowsDesktopRuntimeVersion Condition="'$(LibreWpfWindowsDesktopRuntimeVersion)' == ''">10.0.10</LibreWpfWindowsDesktopRuntimeVersion>
    <LibreWpfWindowsManagedPayloadDir Condition="'$(LibreWpfWindowsManagedPayloadDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows-managed-runtime</LibreWpfWindowsManagedPayloadDir>
    <_LibreWpfNuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_LibreWpfNuGetPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      LibreWPF replaces the managed WindowsDesktop framework reference, so NuGet no
      longer brings the matching WPF native runtime into an AnyCPU application.
      Repack only the native assets. NuGet then selects the process RID at restore
      time without exposing the stock managed WPF assemblies to the consumer.
    -->
    <PackageReference Include="Microsoft.WindowsDesktop.App.Runtime.win-x86"
                      Version="$(LibreWpfWindowsDesktopRuntimeVersion)"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsDesktop.App.Runtime.win-x64"
                      Version="$(LibreWpfWindowsDesktopRuntimeVersion)"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsDesktop.App.Runtime.win-arm64"
                      Version="$(LibreWpfWindowsDesktopRuntimeVersion)"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />

  </ItemGroup>

  <ItemGroup>
    <_LibreWpfWinX86Native Include="$(_LibreWpfNuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x86/$(LibreWpfWindowsDesktopRuntimeVersion)/runtimes/win-x86/native/*.dll" />
    <_LibreWpfWinX64Native Include="$(_LibreWpfNuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64/$(LibreWpfWindowsDesktopRuntimeVersion)/runtimes/win-x64/native/*.dll" />
    <_LibreWpfWinArm64Native Include="$(_LibreWpfNuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-arm64/$(LibreWpfWindowsDesktopRuntimeVersion)/runtimes/win-arm64/native/*.dll" />
    <_LibreWpfWindowsDesktopLicense Include="$(_LibreWpfNuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64/$(LibreWpfWindowsDesktopRuntimeVersion)/LICENSE" />
    <_LibreWpfWinX86PresentationCore Include="$(LibreWpfWindowsManagedPayloadDir)/win-x86/net10.0/PresentationCore.dll" />
    <_LibreWpfWinX64PresentationCore Include="$(LibreWpfWindowsManagedPayloadDir)/win-x64/net10.0/PresentationCore.dll" />
    <_LibreWpfWinArm64PresentationCore Include="$(LibreWpfWindowsManagedPayloadDir)/win-arm64/net10.0/PresentationCore.dll" />
    <_LibreWpfWinX86DirectWriteForwarder Include="$(LibreWpfWindowsManagedPayloadDir)/win-x86/net10.0/DirectWriteForwarder.dll" />
    <_LibreWpfWinX64DirectWriteForwarder Include="$(LibreWpfWindowsManagedPayloadDir)/win-x64/net10.0/DirectWriteForwarder.dll" />
    <_LibreWpfWinArm64DirectWriteForwarder Include="$(LibreWpfWindowsManagedPayloadDir)/win-arm64/net10.0/DirectWriteForwarder.dll" />
    <_LibreWpfWinX86IjwHost Include="$(LibreWpfWindowsManagedPayloadDir)/win-x86/native/ijwhost.dll" />
    <_LibreWpfWinX64IjwHost Include="$(LibreWpfWindowsManagedPayloadDir)/win-x64/native/ijwhost.dll" />
    <_LibreWpfWinArm64IjwHost Include="$(LibreWpfWindowsManagedPayloadDir)/win-arm64/native/ijwhost.dll" />

    <!-- These are NuGet pack items, independent of WPF Arcade's single-platform staging folder. -->
    <None Include="@(_LibreWpfWinX86Native)" Pack="true" PackagePath="runtimes/win-x86/native" />
    <None Include="@(_LibreWpfWinX64Native)" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="@(_LibreWpfWinArm64Native)" Pack="true" PackagePath="runtimes/win-arm64/native" />
    <None Include="@(_LibreWpfWinX86IjwHost)" Pack="true" PackagePath="runtimes/win-x86/native" />
    <None Include="@(_LibreWpfWinX64IjwHost)" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="@(_LibreWpfWinArm64IjwHost)" Pack="true" PackagePath="runtimes/win-arm64/native" />
    <None Include="@(_LibreWpfWindowsDesktopLicense)" Pack="true" PackagePath="notices/Microsoft.WindowsDesktop.App.Runtime" />
    <!--
      PresentationCore's text implementation is selected when it is compiled:
      DirectWrite on Windows, portable SFNT elsewhere. Keep the portable build in
      lib/net10.0 and let NuGet select this AnyCPU Windows build at runtime.
    -->
    <None Include="@(_LibreWpfWinX86PresentationCore)" Pack="true" PackagePath="runtimes/win-x86/lib/net10.0" />
    <None Include="@(_LibreWpfWinX64PresentationCore)" Pack="true" PackagePath="runtimes/win-x64/lib/net10.0" />
    <None Include="@(_LibreWpfWinArm64PresentationCore)" Pack="true" PackagePath="runtimes/win-arm64/lib/net10.0" />
    <None Include="@(_LibreWpfWinX86DirectWriteForwarder)" Pack="true" PackagePath="runtimes/win-x86/lib/net10.0" />
    <None Include="@(_LibreWpfWinX64DirectWriteForwarder)" Pack="true" PackagePath="runtimes/win-x64/lib/net10.0" />
    <None Include="@(_LibreWpfWinArm64DirectWriteForwarder)" Pack="true" PackagePath="runtimes/win-arm64/lib/net10.0" />
  </ItemGroup>

  <Target Name="_ValidateLibreWpfWindowsDesktopNativeAssets"
          BeforeTargets="GenerateNuspec">
    <Error Condition="'@(_LibreWpfWinX86Native)' == ''"
           Text="Microsoft.WindowsDesktop.App.Runtime.win-x86 $(LibreWpfWindowsDesktopRuntimeVersion) native assets were not restored." />
    <Error Condition="'@(_LibreWpfWinX64Native)' == ''"
           Text="Microsoft.WindowsDesktop.App.Runtime.win-x64 $(LibreWpfWindowsDesktopRuntimeVersion) native assets were not restored." />
    <Error Condition="'@(_LibreWpfWinArm64Native)' == ''"
           Text="Microsoft.WindowsDesktop.App.Runtime.win-arm64 $(LibreWpfWindowsDesktopRuntimeVersion) native assets were not restored." />
    <Error Condition="'@(_LibreWpfWindowsDesktopLicense)' == ''"
           Text="Microsoft.WindowsDesktop.App.Runtime $(LibreWpfWindowsDesktopRuntimeVersion) license was not restored." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x86/net10.0/PresentationCore.dll')"
           Text="The win-x86 PresentationCore payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x64/net10.0/PresentationCore.dll')"
           Text="The win-x64 PresentationCore payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-arm64/net10.0/PresentationCore.dll')"
           Text="The win-arm64 PresentationCore payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x86/net10.0/DirectWriteForwarder.dll')"
           Text="The win-x86 DirectWriteForwarder payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x64/net10.0/DirectWriteForwarder.dll')"
           Text="The win-x64 DirectWriteForwarder payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-arm64/net10.0/DirectWriteForwarder.dll')"
           Text="The win-arm64 DirectWriteForwarder payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x86/native/ijwhost.dll')"
           Text="The win-x86 IJW host payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-x64/native/ijwhost.dll')"
           Text="The win-x64 IJW host payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
    <Error Condition="!Exists('$(LibreWpfWindowsManagedPayloadDir)/win-arm64/native/ijwhost.dll')"
           Text="The win-arm64 IJW host payload is missing under $(LibreWpfWindowsManagedPayloadDir)." />
  </Target>

  <ItemGroup>
    <PackagingContent Include="README.md" SubFolder="root" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LibreWPF.Transport.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\..\src\Microsoft.DotNet.Wpf\src\PresentationCore\Fonts\LibreWPF.FluentSymbols\LibreWPF.FluentSymbols.ttf"
          Pack="true"
          PackagePath="buildTransitive/assets/LibreWPF/Fonts" />
    <None Include="..\..\src\Microsoft.DotNet.Wpf\src\PresentationCore\Fonts\LibreWPF.FluentSymbols\NOTICE.md"
          Pack="true"
          PackagePath="notices/LibreWPF.FluentSymbols" />
    <None Include="..\..\src\Microsoft.DotNet.Wpf\src\PresentationCore\Fonts\LibreWPF.FluentSymbols\SOURCE-MANIFEST.json"
          Pack="true"
          PackagePath="notices/LibreWPF.FluentSymbols" />
    <None Include="..\..\src\Microsoft.DotNet.Wpf\src\PresentationCore\Fonts\LibreWPF.FluentSymbols\LegacyFluentGlyphMap.json"
          Pack="true"
          PackagePath="notices/LibreWPF.FluentSymbols" />
    <None Include="..\..\src\Microsoft.DotNet.Wpf\src\PresentationCore\Fonts\LibreWPF.FluentSymbols\licenses\*"
          Pack="true"
          PackagePath="notices/LibreWPF.FluentSymbols/licenses" />
  </ItemGroup>

  <Target Name="RemoveStaleLibreWpfTransportPayload"
          BeforeTargets="CreateContentFolder"
          Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_StaleLibreWpfTransportPayload
        Include="$(ArtifactsPackagingDir)$(NormalizedPackageName)\lib\**\*"
        Exclude="$(ArtifactsPackagingDir)$(NormalizedPackageName)\lib\$(TargetFramework)\**\*" />
      <_StaleLibreWpfTransportPayload
        Include="$(ArtifactsPackagingDir)$(NormalizedPackageName)\ref\**\*"
        Exclude="$(ArtifactsPackagingDir)$(NormalizedPackageName)\ref\$(TargetFramework)\**\*" />
      <_StaleLibreWpfTransportPayload
        Include="$(ArtifactsPackagingDir)$(NormalizedPackageName)\runtime.json" />
    </ItemGroup>

    <Delete Files="@(_StaleLibreWpfTransportPayload)" />
  </Target>
</Project>
