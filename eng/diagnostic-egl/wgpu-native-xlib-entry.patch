+// ProGPU optional Linux ABI extension. Standard WebGPU records and entry points
+// retain their original layouts. The source Xlib connection must remain live.
+#[cfg(target_os = "linux")]
+#[no_mangle]
+pub unsafe extern "C" fn progpuWgpuCreateInstanceXlibV1(
+    descriptor: Option<&native::WGPUInstanceDescriptor>,
+    display: *mut std::ffi::c_void,
+    screen: i32,
+) -> native::WGPUInstance {
+    // The standard native Xlib surface descriptor transports screen zero only.
+    if display.is_null() || screen != 0 {
+        return std::ptr::null();
+    }
+    let mut description = match descriptor {
+        Some(descriptor) => follow_chain!(map_instance_descriptor(
+            (descriptor),
+            WGPUSType_InstanceExtras => native::WGPUInstanceExtras
+        )),
+        None => wgt::InstanceDescriptor::default(),
+    };
+    let include_gl = description.backends.contains(wgt::Backends::GL);
+    let gl_description = hal::InstanceDescriptor {
+        name: "ProGPU source Xlib",
+        flags: description.flags,
+        dx12_shader_compiler: description.dx12_shader_compiler.clone(),
+        gles_minor_version: description.gles_minor_version,
+    };
+    description.backends.remove(wgt::Backends::GL);
+    let mut instance = wgc::instance::Instance::new("wgpu", description);
+    if include_gl {
+        match unsafe { <hal::api::Gles as hal::Api>::Instance::init_xlib_owned(&gl_description, display, screen) } {
+            Ok(gl) => instance.gl = Some(gl),
+            Err(error) => {
+                log::error!("Explicit source Xlib instance failed: {:?}", error);
+                return std::ptr::null();
+            }
+        }
+    }
+    Arc::into_raw(Arc::new(WGPUInstanceImpl {
+        context: Arc::new(Context::from_instance(wgc::identity::IdentityManagerFactory, instance)),
+    }))
+}
