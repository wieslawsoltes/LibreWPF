+// A live explicit EGL display may belong to only one backend instance. This
+// guard remains with all context clones until native teardown has completed.
+static EXPLICIT_X_DISPLAYS: Mutex<Vec<usize>> = Mutex::new(Vec::new());
+
+#[derive(Debug)]
+struct ExplicitXDisplayOwner {
+    _native: Rc<DisplayOwner>,
+    identity: usize,
+}
+
+impl Drop for ExplicitXDisplayOwner {
+    fn drop(&mut self) {
+        let mut active = EXPLICIT_X_DISPLAYS.lock();
+        if let Some(index) = active.iter().position(|&value| value == self.identity) {
+            active.swap_remove(index);
+        }
+    }
+}
+
+// Context clones are actual users, so the last one owns native teardown. The
+// ordinary backend retains its existing Inner teardown contract.
+#[derive(Debug)]
+struct ExplicitXResources {
+    _owner: Rc<ExplicitXDisplayOwner>,
+    instance: Arc<EglInstance>,
+    display: khronos_egl::Display,
+    context: khronos_egl::Context,
+    pbuffer: Option<khronos_egl::Surface>,
+}
+
+impl Drop for ExplicitXResources {
+    fn drop(&mut self) {
+        if let Some(surface) = self.pbuffer {
+            if let Err(error) = self.instance.destroy_surface(self.display, surface) {
+                log::warn!("Error destroying explicit Xlib pbuffer: {:?}", error);
+            }
+        }
+        if let Err(error) = self.instance.destroy_context(self.display, self.context) {
+            log::warn!("Error destroying explicit Xlib context: {:?}", error);
+        }
+        if let Err(error) = self.instance.terminate(self.display) {
+            log::warn!("Error terminating explicit Xlib display: {:?}", error);
+        }
+    }
+}
