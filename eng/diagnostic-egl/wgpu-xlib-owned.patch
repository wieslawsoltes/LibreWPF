+// The caller retains the original source connection. This backend owns a separate
+// connection to that explicitly named X server, so terminating its EGLDisplay
+// cannot terminate another instance's or the window toolkit's EGL resources.
+unsafe fn open_source_x_display(source: *mut raw::c_void, screen: i32)
+    -> Result<DisplayOwner, crate::InstanceError>
+{
+    if source.is_null() || screen < 0 {
+        return Err(crate::InstanceError::new("Invalid source Xlib display or screen".into()));
+    }
+    let library = find_library(&["libX11.so.6", "libX11.so"])
+        .ok_or_else(|| crate::InstanceError::new("Xlib library unavailable".into()))?;
+    type DisplayName = unsafe extern "system" fn(*mut raw::c_void) -> *const raw::c_char;
+    type ScreenCount = unsafe extern "system" fn(*mut raw::c_void) -> raw::c_int;
+    let name: libloading::Symbol<DisplayName> = unsafe { library.get(b"XDisplayString") }
+        .map_err(|e| crate::InstanceError::with_source("XDisplayString unavailable".into(), e))?;
+    let count: libloading::Symbol<ScreenCount> = unsafe { library.get(b"XScreenCount") }
+        .map_err(|e| crate::InstanceError::with_source("XScreenCount unavailable".into(), e))?;
+    let open: libloading::Symbol<XOpenDisplayFun> = unsafe { library.get(b"XOpenDisplay") }
+        .map_err(|e| crate::InstanceError::with_source("XOpenDisplay unavailable".into(), e))?;
+    let display_name = unsafe { name(source) };
+    if display_name.is_null() || screen >= unsafe { count(source) } {
+        return Err(crate::InstanceError::new("Source Xlib screen unavailable".into()));
+    }
+    let display = ptr::NonNull::new(unsafe { open(display_name) })
+        .ok_or_else(|| crate::InstanceError::new("Could not connect to the source X server".into()))?;
+    let owner = DisplayOwner { display: DisplayRef::X11(display), library };
+    let count: libloading::Symbol<ScreenCount> = unsafe { owner.library.get(b"XScreenCount") }
+        .map_err(|e| crate::InstanceError::with_source("XScreenCount unavailable".into(), e))?;
+    if screen >= unsafe { count(display.as_ptr()) } {
+        return Err(crate::InstanceError::new("Connected source screen unavailable".into()));
+    }
+    Ok(owner)
+}
