<Project Sdk="LibreWPF.Sdk/@SDK_VERSION@">
  <PropertyGroup>
    <!-- The disposable CI runner starts this diagnostic host in its own console.
         Original Gallery sources, window behavior and capture checks stay intact. -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProGpuWpfReferenceMode>Package</ProGpuWpfReferenceMode>
    <ProGpuPackageVersion>@ENGINE_VERSION@</ProGpuPackageVersion>
    <ProGpuWpfRendererMode>NativeMilWgpu</ProGpuWpfRendererMode>
    <ProGpuWpfNativeMilHitTesting>true</ProGpuWpfNativeMilHitTesting>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GalleryClipboardApp.cs" />
    <Compile Include="original/**/*.cs" />
    <Page Include="original/**/*.xaml"><Link>%(RecursiveDir)%(Filename)%(Extension)</Link></Page>
    <Resource Include="original/Assets/ControlImages/Clipboard.png"><Link>Assets/ControlImages/Clipboard.png</Link></Resource>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
</Project>
