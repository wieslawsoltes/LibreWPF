<Window
    x:Class="ProGPU.Wpf.ShowcaseApp.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About ProGPU WPF Showcase"
    Width="360"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Border
        Padding="18"
        Background="{DynamicResource ShowcasePanelBrush}">
        <StackPanel>
            <TextBlock
                x:Name="AboutTitleText"
                FontSize="18"
                FontWeight="SemiBold"
                Text="ProGPU WPF Showcase" />
            <TextBlock
                x:Name="AboutBodyText"
                Margin="0,8,0,0"
                Text="Standard secondary WPF Window compiled through the ProGPU SDK."
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="AboutCloseButton"
                    MinWidth="88"
                    Content="OK"
                    IsCancel="True"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
