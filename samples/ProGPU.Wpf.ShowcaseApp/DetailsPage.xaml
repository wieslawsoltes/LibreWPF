<Page
    x:Class="ProGPU.Wpf.ShowcaseApp.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Details">
    <StackPanel Margin="12">
        <TextBlock
            x:Name="DetailsTitle"
            FontSize="18"
            FontWeight="SemiBold"
            Text="SDK details page" />
        <ListBox
            x:Name="DetailsList"
            Margin="0,10,0,0">
            <ListBoxItem Content="Compiled Page" />
            <ListBoxItem Content="Frame navigation" />
            <ListBoxItem Content="Default SDK XAML items" />
        </ListBox>
    </StackPanel>
</Page>
