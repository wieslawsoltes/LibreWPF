<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ShowcaseComponentPackText">Component pack dictionary ready</sys:String>
    <SolidColorBrush x:Key="ShowcaseComponentPackBrush" Color="#6B4E23" />
    <Style x:Key="ShowcaseComponentPackTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ShowcaseComponentPackBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
