                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,14,0,8"
                            FontWeight="SemiBold"
                            Text="Container style selector list" />

                        <ListBox
                            x:Name="StyleSelectorItemsList"
                            Grid.Row="5"
                            DisplayMemberPath="Name"
                            ItemContainerStyleSelector="{StaticResource ShowcaseItemContainerStyleSelector}"
                            ItemsSource="{Binding Items}" />
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Resource template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The selected item view is generated by a compiled DataTemplate, while the list below uses a DataTemplateSelector, ItemContainerStyle, and ItemsPanelTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Themes">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="ControlTemplate style" />
                        <Button
                            x:Name="TemplateButton"
                            Content="Templated action"
                            Style="{StaticResource ShowcaseTemplateButtonStyle}" />
                        <Button
                            x:Name="BasedOnStyleButton"
                            Margin="0,12,8,0"
                            Content="BasedOn style"
                            Style="{StaticResource ShowcaseBasedOnButtonStyle}" />
                        <TextBlock
                            x:Name="StyleTriggerText"
                            Margin="0,14,0,0"
                            Style="{StaticResource ShowcaseTriggerTextBlockStyle}" />
                        <TextBlock
                            x:Name="MultiTriggerText"
                            Margin="0,8,0,0"
                            Style="{StaticResource ShowcaseMultiTriggerTextBlockStyle}" />
                        <TextBlock
                            x:Name="MultiDataTriggerText"
                            Margin="0,8,0,0"
                            Style="{StaticResource ShowcaseMultiDataTriggerTextBlockStyle}" />
                        <Button
                            x:Name="EventSetterStyleButton"
                            Margin="0,12,8,0"
                            Content="EventSetter action"
                            Style="{StaticResource ShowcaseEventSetterButtonStyle}" />
                        <TextBlock
                            x:Name="EventSetterStatusText"
                            Margin="0,8,0,0"
                            Text="EventSetter idle" />
                        <StackPanel
                            x:Name="LocalThemeScope"
                            Margin="0,12,0,0">
                            <StackPanel.Resources>
                                <SolidColorBrush
                                    x:Key="LocalThemeBrush"
                                    Color="#7C2D12" />
                                <Style
                                    BasedOn="{StaticResource {x:Type TextBlock}}"
                                    TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource LocalThemeBrush}" />
                                    <Setter Property="Tag" Value="LocalThemeScopeText" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock
                                x:Name="LocalThemeText"
                                Text="Local implicit style" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Theme template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The button is styled through a compiled ControlTemplate, TemplateBinding, named parts, VisualStateManager states, and a property trigger." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Validation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Validated form field" />
                        <TextBox
                            x:Name="ValidationTextBox"
                            Validation.ErrorTemplate="{StaticResource ShowcaseValidationErrorTemplate}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="ValidationText"
                                    UpdateSourceTrigger="Explicit">
                                    <Binding.ValidationRules>
                                        <local:ShowcaseNonEmptyValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="ValidationEchoText"
                            Margin="0,14,0,0"
                            Text="{Binding ValidationText, StringFormat=Current: {0}}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,16,0,8"
                            FontWeight="SemiBold"
                            Text="Source-side validation" />
                        <TextBox x:Name="DataErrorTextBox">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="DataErrorText"
                                    UpdateSourceTrigger="Explicit"
                                    ValidatesOnDataErrors="True" />
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="DataErrorEchoText"
                            Margin="0,8,0,0"
                            Text="{Binding DataErrorText, StringFormat=Data: {0}}"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="NotifyDataErrorTextBox"
                            Margin="0,12,0,0">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="NotifyDataErrorText"
                                    UpdateSourceTrigger="Explicit"
                                    ValidatesOnNotifyDataErrors="True" />
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="NotifyDataErrorEchoText"
                            Margin="0,8,0,0"
                            Text="{Binding NotifyDataErrorText, StringFormat=Notify: {0}}"
                            TextWrapping="Wrap" />
                        <Separator Margin="0,18,0,14" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Grouped commit validation" />
                        <StackPanel x:Name="BindingGroupPanel">
                            <StackPanel.BindingGroup>
                                <BindingGroup Name="ShowcaseBindingGroup">
                                    <BindingGroup.ValidationRules>
                                        <local:ShowcaseBindingGroupValidationRule
                                            FirstProperty="BindingGroupFirstName"
                                            RequiredPrefix="group:"
                                            SecondProperty="BindingGroupLastName" />
                                    </BindingGroup.ValidationRules>
                                </BindingGroup>
                            </StackPanel.BindingGroup>
                            <TextBox
                                x:Name="BindingGroupFirstBox"
                                Text="{Binding BindingGroupFirstName, UpdateSourceTrigger=Explicit}" />
                            <TextBox
                                x:Name="BindingGroupLastBox"
                                Margin="0,8,0,0"
                                Text="{Binding BindingGroupLastName, UpdateSourceTrigger=Explicit}" />
                            <Button
                                x:Name="BindingGroupCommitButton"
                                Margin="0,10,0,0"
                                Click="OnBindingGroupCommitClick"
                                Content="Commit grouped edit" />
                            <TextBlock
                                x:Name="BindingGroupStatusText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupStatus}" />
                            <TextBlock
                                x:Name="BindingGroupFirstEchoText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupFirstName, StringFormat=First: {0}}" />
                            <TextBlock
                                x:Name="BindingGroupLastEchoText"
                                Text="{Binding BindingGroupLastName, StringFormat=Last: {0}}" />
                        </StackPanel>
                        <Separator Margin="0,18,0,14" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Adorner layer" />
                        <AdornerDecorator
                            x:Name="ShowcaseAdornerDecorator"
                            Margin="0,0,0,0">
                            <Border
                                x:Name="ShowcaseAdornerTarget"
                                MinHeight="38"
                                Padding="8"
                                Background="#FFFFFF"
                                BorderBrush="#94A3B8"
                                BorderThickness="1">
                                <TextBlock Text="Adorner target" />
                            </Border>
                        </AdornerDecorator>
                        <TextBlock
                            x:Name="ShowcaseAdornerStatusText"
                            Margin="0,8,0,0"
                            Text="Adorner idle" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Binding validation" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses a normal WPF ValidationRule, explicit source updates, and a compiled Validation.ErrorTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Animation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Storyboard triggers" />
                        <TextBlock
                            x:Name="LoadedStoryboardText"
                            Opacity="1"
                            Text="Loaded storyboard target">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="LoadedStoryboardText"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.42" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <Button
                            x:Name="ClickStoryboardButton"
                            Margin="0,14,0,0"
                            Content="Animate click target"
                            Opacity="1">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ClickStoryboardButton"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.58" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="EventTrigger clocks" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses compiled EventTrigger and BeginStoryboard timelines loaded through the ProGPU WPF SDK." />
                            <Border
                                x:Name="ShowcaseDropShadowEffectBorder"
                                Margin="0,16,0,0"
                                Padding="10"
                                Background="#FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="9"
                                        Color="#334155"
                                        Direction="315"
                                        Opacity="0.55"
                                        RenderingBias="Quality"
                                        ShadowDepth="4" />
                                </Border.Effect>
                                <TextBlock Text="DropShadowEffect" />
                            </Border>
                            <Border
                                x:Name="ShowcaseBlurEffectBorder"
                                Margin="0,12,0,0"
                                Padding="10"
                                Background="#DBEAFE">
                                <Border.Effect>
                                    <BlurEffect
                                        KernelType="Gaussian"
                                        Radius="2.5"
                                        RenderingBias="Quality" />
                                </Border.Effect>
                                <TextBlock Text="BlurEffect" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Navigation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame
                        x:Name="NavigationFrame"
                        NavigationUIVisibility="Visible"
                        Source="OverviewPage.xaml" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <Button
                            x:Name="OverviewNavigationButton"
                            Content="Overview"
                            Click="OnOverviewNavigationClick" />
                        <Button
                            x:Name="DetailsNavigationButton"
                            Content="Details"
                            Click="OnDetailsNavigationClick" />
                        <Button
                            x:Name="BackNavigationButton"
                            Margin="0,12,0,0"
                            Command="NavigationCommands.BrowseBack"
                            CommandTarget="{Binding ElementName=NavigationFrame}"
                            Content="Back" />
                        <Button
                            x:Name="ForwardNavigationButton"
                            Margin="0,6,0,0"
                            Command="NavigationCommands.BrowseForward"
                            CommandTarget="{Binding ElementName=NavigationFrame}"
                            Content="Forward" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Editing">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Password entry" />
                        <PasswordBox
                            x:Name="EditorPasswordBox"
                            MaxLength="16"
                            PasswordChanged="OnEditorPasswordChanged"
                            PasswordChar="*" />
                        <TextBlock
                            Margin="0,16,0,8"
                            FontWeight="SemiBold"
                            Text="Data transfer" />
                        <TextBox
                            x:Name="DataObjectPayloadTextBox"
                            Text="data object payload" />
                        <Button
                            x:Name="DataObjectRoundTripButton"
                            Margin="0,10,0,0"
                            Click="OnDataObjectRoundTripClick"
                            Content="Round-trip DataObject" />
                        <Button
                            x:Name="ClipboardRoundTripButton"
                            Margin="0,6,0,0"
                            Click="OnClipboardRoundTripClick"
                            Content="Round-trip Clipboard" />
                        <Button
                            x:Name="SelectAllPayloadButton"
                            Margin="0,6,0,0"
                            Command="ApplicationCommands.SelectAll"
                            CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                            Content="Select all payload" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button
                                x:Name="CopyPayloadButton"
                                Command="ApplicationCommands.Copy"
                                CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                                Content="Copy payload" />
                            <Button
                                x:Name="CutPayloadButton"
                                Margin="6,0,0,0"
                                Command="ApplicationCommands.Cut"
                                CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                                Content="Cut payload" />
                            <Button
                                x:Name="PastePayloadButton"
                                Margin="6,0,0,0"
                                Command="ApplicationCommands.Paste"
                                CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                                Content="Paste payload" />
                            <Button
                                x:Name="UndoPayloadButton"
                                Margin="6,0,0,0"
                                Command="ApplicationCommands.Undo"
                                CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                                Content="Undo payload" />
                            <Button
                                x:Name="RedoPayloadButton"
                                Margin="6,0,0,0"
                                Command="ApplicationCommands.Redo"
                                CommandTarget="{Binding ElementName=DataObjectPayloadTextBox}"
                                Content="Redo payload" />
                        </WrapPanel>
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal">
                            <Button
                                x:Name="CopyRichTextButton"
                                Command="ApplicationCommands.Copy"
                                CommandTarget="{Binding ElementName=EditorRichTextBox}"
                                Content="Copy rich text" />
                            <Button
                                x:Name="PasteRichTextButton"
                                Margin="6,0,0,0"
                                Command="ApplicationCommands.Paste"
                                CommandTarget="{Binding ElementName=EditorRichTextBox}"
                                Content="Paste rich text" />
                        </StackPanel>
                        <TextBlock
                            x:Name="DataObjectStatusText"
                            Margin="0,8,0,0"
                            Text="DataObject idle"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <RichTextBox
                        x:Name="EditorRichTextBox"
                        Grid.Row="1"
                        Margin="0,16,0,0">
                        <FlowDocument PagePadding="6">
                            <Paragraph>
                                <Run Text="Editable plain text" />
                                <Bold>
                                    <Run Text="bold text" />
                                </Bold>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Text editing" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses WPF PasswordBox, RichTextBox, FlowDocument, TextRange, EditingCommands, text editor commands, DataObject, and Clipboard through SDK-built BAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Document">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <FlowDocumentScrollViewer
                        x:Name="DocumentViewer"
                        Grid.RowSpan="2"
                        VerticalScrollBarVisibility="Auto">
                        <FlowDocument PagePadding="12">
                            <Paragraph FontSize="18" FontWeight="SemiBold">
                                Managed WPF document content
                            </Paragraph>
                            <Paragraph>
                                This document is compiled as normal WPF XAML through the ProGPU SDK. It is intentionally simple
                                so it can be used as a fast manual smoke app while rendering, input, layout, and packaging mature.
                                <Hyperlink
                                    NavigateUri="https://github.com/wieslawsoltes/ProGPU"
                                    RequestNavigate="OnDocumentLinkRequestNavigate">ProGPU renderer</Hyperlink>
                            </Paragraph>
                            <List>
                                <ListItem><Paragraph>Application and window lifecycle</Paragraph></ListItem>
                                <ListItem><Paragraph>Bindings, commands, and item templates</Paragraph></ListItem>
                                <ListItem><Paragraph>Basic document object graph reuse</Paragraph></ListItem>
                            </List>
                        </FlowDocument>
                    </FlowDocumentScrollViewer>

                    <FlowDocumentPageViewer
                        x:Name="DocumentPageViewer"
                        Grid.Column="1"
                        Margin="16,0,0,8"
                        MaxZoom="250"
                        MinZoom="50"
                        Zoom="125">
                        <FlowDocument
                            ColumnWidth="360"
                            PagePadding="5">
                            <Paragraph FontWeight="SemiBold">
                                Page viewer document
                            </Paragraph>
                            <List MarkerStyle="Square">
                                <ListItem><Paragraph>Showcase page viewer item</Paragraph></ListItem>
                            </List>
                        </FlowDocument>
                    </FlowDocumentPageViewer>

                    <FlowDocumentReader
                        x:Name="DocumentReader"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="16,8,0,0"
                        ViewingMode="Scroll">
                        <FlowDocument PagePadding="3">
                            <Paragraph>
                                Showcase reader document
                            </Paragraph>
                        </FlowDocument>
                    </FlowDocumentReader>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock
                    x:Name="CommandStatusText"
                    Text="{Binding CommandStatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
