<Window
    x:Class="ProGPU.Wpf.ShowcaseApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:local="clr-namespace:ProGPU.Wpf.ShowcaseApp"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework"
    x:Name="RootWindow"
    Title="ProGPU WPF Showcase"
    Width="760"
    Height="560"
    Loaded="OnShowcaseWindowLoaded"
    MinWidth="560"
    MinHeight="420">
    <Window.CommandBindings>
        <CommandBinding
            Command="{x:Static local:MainWindow.RefreshStatusCommand}"
            CanExecute="OnRefreshStatusCommandCanExecute"
            Executed="OnRefreshStatusCommandExecuted" />
        <CommandBinding
            Command="{x:Static wpf:SystemCommands.MaximizeWindowCommand}"
            CanExecute="OnSystemCommandCanExecute"
            Executed="OnSystemCommandExecuted" />
        <CommandBinding
            Command="{x:Static wpf:SystemCommands.MinimizeWindowCommand}"
            CanExecute="OnSystemCommandCanExecute"
            Executed="OnSystemCommandExecuted" />
        <CommandBinding
            Command="{x:Static wpf:SystemCommands.RestoreWindowCommand}"
            CanExecute="OnSystemCommandCanExecute"
            Executed="OnSystemCommandExecuted" />
        <CommandBinding
            Command="{x:Static wpf:SystemCommands.ShowSystemMenuCommand}"
            CanExecute="OnSystemCommandCanExecute"
            Executed="OnSystemCommandExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding
            Key="R"
            Modifiers="Control"
            Command="{x:Static local:MainWindow.RefreshStatusCommand}" />
        <MouseBinding
            MouseAction="LeftDoubleClick"
            Command="{x:Static local:MainWindow.RefreshStatusCommand}"
            CommandParameter="showcase mouse binding payload"
            CommandTarget="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>
    <Window.Resources>
        <shell:WindowChrome
            x:Key="ShowcaseWindowChromeMetadata"
            CaptionHeight="32"
            CornerRadius="8"
            GlassFrameThickness="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
        <local:ShowcaseActiveTextConverter x:Key="ShowcaseActiveTextConverter" />
        <local:ShowcaseItemSummaryConverter x:Key="ShowcaseItemSummaryConverter" />
        <DataTemplate
            x:Key="ShowcaseActiveItemTemplate"
            DataType="{x:Type local:ShowcaseItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#E7F5EE">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorActiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#236B46"
                        Text="Active item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="ShowcaseInactiveItemTemplate"
            DataType="{x:Type local:ShowcaseItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#F2F3F6">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorInactiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#5B6472"
                        Text="Inactive item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <local:ShowcaseItemTemplateSelector
            x:Key="ShowcaseItemTemplateSelector"
            ActiveTemplate="{StaticResource ShowcaseActiveItemTemplate}"
            InactiveTemplate="{StaticResource ShowcaseInactiveItemTemplate}" />
        <ObjectDataProvider
            x:Key="ShowcaseObjectDataProvider"
            IsAsynchronous="False"
            MethodName="CreateSummary"
            ObjectType="{x:Type local:ShowcaseResourceFactory}">
            <ObjectDataProvider.MethodParameters>
                <sys:String>showcase-provider</sys:String>
                <sys:Int32>9</sys:Int32>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <XmlDataProvider
            x:Key="ShowcaseXmlDataProvider"
            IsAsynchronous="False"
            XPath="/showcase/item">
            <x:XData>
                <showcase xmlns="">
                    <item name="showcase-xml" value="provider" />
                </showcase>
            </x:XData>
        </XmlDataProvider>
        <x:Array
            x:Key="ShowcaseStringArray"
            Type="{x:Type sys:String}">
            <sys:String>Array alpha</sys:String>
            <sys:String>Array beta</sys:String>
        </x:Array>
        <CompositeCollection x:Key="ShowcaseCompositeCollection">
            <sys:String>Composite static</sys:String>
            <CollectionContainer Collection="{x:Static local:ShowcaseCompositeItemsProvider.Items}" />
            <sys:String>Composite final</sys:String>
        </CompositeCollection>
        <DrawingImage x:Key="ShowcaseDrawingImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2F80ED">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 8,18 L 14,24 L 25,9 L 28,12 L 14,28 L 5,20 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <ImageBrush
            x:Key="ShowcaseDrawingImageBrush"
            ImageSource="{StaticResource ShowcaseDrawingImage}"
            Stretch="Uniform" />
        <SolidColorBrush
            x:Key="ShowcaseSharedFalseBrush"
            x:Shared="False"
            Color="#8B5CF6" />
        <SolidColorBrush
            x:Key="ShowcaseFreezableBrush"
            Color="#0F766E" />
        <ControlTemplate x:Key="ShowcaseValidationErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="ShowcaseValidationErrorPlaceholder" />
                <TextBlock
                    x:Name="ShowcaseValidationErrorText"
                    Margin="0,4,0,0"
                    Foreground="#B42318"
                    Text="{Binding [0].ErrorContent}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ControlTemplate>
        <Style
            x:Key="ShowcaseSelectorItemContainerStyle"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tag" Value="ActiveContainer" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ShowcaseActiveItemContainerStyle"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Tag" Value="ActiveStyleContainer" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="ShowcaseInactiveItemContainerStyle"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Tag" Value="InactiveStyleContainer" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <local:ShowcaseItemContainerStyleSelector
            x:Key="ShowcaseItemContainerStyleSelector"
            ActiveStyle="{StaticResource ShowcaseActiveItemContainerStyle}"
            InactiveStyle="{StaticResource ShowcaseInactiveItemContainerStyle}" />
        <Style
            x:Key="ShowcaseEventSetterButtonStyle"
            TargetType="{x:Type Button}">
            <Setter Property="Tag" Value="EventSetterStyle" />
            <EventSetter Event="Click" Handler="OnShowcaseStyleEventSetterClick" />
        </Style>
        <CollectionViewSource
            x:Key="ItemsViewSource"
            Filter="OnItemsViewSourceFilter">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Category" />
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <HierarchicalDataTemplate
            x:Key="ShowcaseNodeTemplate"
            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="130"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBlock
                    Foreground="#5B6472"
                    Text="{Binding Kind, StringFormat=Kind: {0}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Menu
                x:Name="MainMenu"
                Margin="0,0,0,10">
                <MenuItem
                    x:Name="FileMenuItem"
                    Header="_File">
                    <MenuItem
                        x:Name="AddMenuItem"
                        Command="{Binding AddItemCommand}"
                        Header="_Add item"
                        InputGestureText="Ctrl+N" />
                    <Separator />
                    <MenuItem
                        x:Name="ResetMenuItem"
                        Command="{Binding ResetCommand}"
                        Header="_Reset" />
                    <Separator />
                    <MenuItem
                        x:Name="AboutMenuItem"
                        Click="OnAboutMenuItemClick"
                        Header="_About" />
                </MenuItem>
                <MenuItem
                    x:Name="ViewMenuItem"
                    Header="_View">
                    <MenuItem
                        x:Name="ActionsEnabledMenuItem"
                        Header="_Enable actions"
                        IsCheckable="True"
                        IsChecked="{Binding ActionsEnabled}" />
                    <Separator />
                    <MenuItem
                        x:Name="RefreshMenuItem"
                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                        Header="_Refresh status"
                        InputGestureText="Ctrl+R" />
                </MenuItem>
                <MenuItem
                    x:Name="ThemeMenuItem"
                    Header="_Theme">
                    <MenuItem
                        x:Name="AeroThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="_Aero"
                        IsCheckable="True"
                        Tag="Aero" />
                    <MenuItem
                        x:Name="Aero2ThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="Aero _2"
                        IsCheckable="True"
                        Tag="Aero2" />
                    <MenuItem
                        x:Name="AeroLiteThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="Aero _Lite"
                        IsCheckable="True"
                        Tag="AeroLite" />
                    <MenuItem
                        x:Name="ClassicThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="_Classic"
                        IsCheckable="True"
                        Tag="Classic" />
                    <MenuItem
                        x:Name="FluentThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="_Fluent"
                        IsCheckable="True"
                        IsChecked="True"
                        Tag="Fluent" />
                    <MenuItem
                        x:Name="LunaThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="L_una"
                        IsCheckable="True"
                        Tag="Luna" />
                    <MenuItem
                        x:Name="RoyaleThemeMenuItem"
                        Click="OnFrameworkThemeMenuItemClick"
                        Header="_Royale"
                        IsCheckable="True"
                        Tag="Royale" />
                </MenuItem>
                <MenuItem
                    x:Name="WindowMenuItem"
                    Header="_Window">
                    <MenuItem
                        x:Name="WindowMaximizeMenuItem"
                        Command="{x:Static wpf:SystemCommands.MaximizeWindowCommand}"
                        CommandParameter="showcase maximize"
                        CommandTarget="{Binding ElementName=RootWindow}"
                        Header="Ma_ximize" />
                    <MenuItem
                        x:Name="WindowMinimizeMenuItem"
                        Command="{x:Static wpf:SystemCommands.MinimizeWindowCommand}"
                        CommandParameter="showcase minimize"
                        CommandTarget="{Binding ElementName=RootWindow}"
                        Header="Mi_nimize" />
                    <MenuItem
                        x:Name="WindowRestoreMenuItem"
                        Command="{x:Static wpf:SystemCommands.RestoreWindowCommand}"
                        CommandParameter="showcase restore"
                        CommandTarget="{Binding ElementName=RootWindow}"
                        Header="_Restore" />
                    <Separator />
                    <MenuItem
                        x:Name="WindowSystemMenuItem"
                        Command="{x:Static wpf:SystemCommands.ShowSystemMenuCommand}"
                        CommandParameter="showcase system menu"
                        CommandTarget="{Binding ElementName=RootWindow}"
                        Header="_System menu" />
                </MenuItem>
            </Menu>
            <TextBlock
                x:Name="ShowcaseTitleText"
                FontSize="22"
                FontWeight="SemiBold"
                Text="ProGPU WPF Showcase" />
            <TextBlock
                Margin="0,4,0,14"
                Foreground="#5B6472"
                Text="A no-source-change SDK app using regular WPF XAML, bindings, commands, controls, and documents." />
        </StackPanel>

        <TabControl
            x:Name="ShowcaseTabControl"
            Grid.Row="1"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
            SelectionChanged="OnShowcaseTabSelectionChanged">
            <TabItem Header="Controls">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameTextBox"
                                AutomationProperties.AutomationId="ShowcaseNameTextBoxAutomation"
                                AutomationProperties.HelpText="Enter the next Showcase item name"
                                AutomationProperties.Name="Showcase item name"
                                VerticalContentAlignment="Center"
                                Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Name="AddItemButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding AddItemCommand}"
                                Content="Add item" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox
                            x:Name="ItemsList"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <ListBox.ContextMenu>
                                <ContextMenu
                                    x:Name="ItemsContextMenu"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                        x:Name="ContextAddMenuItem"
                                        Command="{Binding AddItemCommand}"
                                        Header="_Add item" />
                                    <MenuItem
                                        x:Name="ContextRefreshMenuItem"
                                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                        Header="_Refresh status" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="ContextActionsEnabledMenuItem"
                                        Header="_Enable actions"
                                        IsCheckable="True"
                                        IsChecked="{Binding ActionsEnabled}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="120"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="#5B6472"
                                            Text="{Binding Category, StringFormat=Category: {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,6"
                            FontWeight="SemiBold"
                            Text="Tabular view" />

                        <DataGrid
                            x:Name="ItemsDataGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridCheckBoxColumn
                                    Binding="{Binding IsActive}"
                                    Header="Active" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        local:ShowcaseStateProperties.SectionName="Overview tools">
                        <CheckBox
                            x:Name="EnabledCheckBox"
                            Margin="0,0,0,12"
                            AutomationProperties.AutomationId="ShowcaseActionsEnabledAutomation"
                            AutomationProperties.HelpText="Toggles whether Showcase commands can execute"
                            AutomationProperties.Name="Showcase actions enabled"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled}" />
                        <TextBlock Text="Progress" />
                        <Slider
                            x:Name="ProgressSlider"
                            AutomationProperties.AutomationId="ShowcaseProgressSliderAutomation"
                            AutomationProperties.HelpText="Adjusts Showcase progress"
                            AutomationProperties.Name="Showcase progress"
                            LargeChange="10"
                            Minimum="0"
                            Maximum="100"
                            SmallChange="2"
                            Value="{Binding Progress}" />
                        <ProgressBar
                            Height="16"
                            Margin="0,4,0,12"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ComboBox
                            x:Name="CategoryCombo"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                        <Button
                            Margin="0,14,0,0"
                            Command="{Binding ResetCommand}"
                            Content="Reset" />
                        <Button
                            x:Name="RequeryCommandButton"
                            Margin="0,8,0,0"
                            AutomationProperties.AutomationId="ShowcaseRequeryCommandAutomation"
                            AutomationProperties.HelpText="Runs the requery command"
                            AutomationProperties.Name="Showcase requery command"
                            Command="{Binding RequeryCommand}"
                            CommandParameter="showcase requery command payload"
                            Content="Run requery command" />
                        <Button
                            x:Name="ShowcaseMessageBoxButton"
                            Margin="0,8,0,0"
                            Click="OnMessageBoxButtonClick"
                            Content="Show MessageBox" />
                        <TextBlock
                            x:Name="MessageBoxStatusText"
                            Margin="0,6,0,0"
                            Text="MessageBox idle"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ShowcaseFileDialogButton"
                            Margin="0,8,0,0"
                            Click="OnFileDialogButtonClick"
                            Content="Run file dialogs" />
                        <TextBlock
                            x:Name="FileDialogStatusText"
                            Margin="0,6,0,0"
                            Text="File dialogs idle"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,18,0,4"
                            FontWeight="SemiBold"
                            Text="Chrome metadata" />
                        <Border
                            x:Name="ChromeCaptionRegion"
                            Padding="8"
                            Background="#E8EDF5"
                            MouseLeftButtonDown="OnChromeCaptionMouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="ProGPU chrome metadata" />
                                <Button
                                    x:Name="ChromeHitTestButton"
                                    Grid.Column="1"
                                    MinWidth="92"
                                    Margin="8,0,0,0"
                                    Padding="6,2"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Content="Caption action" />
                            </Grid>
                        </Border>
                        <primitives:Thumb
                            x:Name="ChromeResizeGrip"
                            Width="18"
                            Height="18"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.ResizeGripDirection="BottomRight" />
                        <local:SummaryPanel
                            x:Name="SummaryPanel"
                            Margin="0,18,0,0"
                            HeaderText="{Binding StatusText}" />
                        <local:ShowcaseHeaderTextBlock
                            x:Name="DependencyPropertyManagerText"
                            Margin="0,8,0,0"
                            local:ShowcaseStateProperties.Importance="128"
                            HeaderText="{Binding StatusText}"
                            TypedOffset="12.5,24.25"
                            Text="{Binding RelativeSource={RelativeSource Self}, Path=(local:ShowcaseStateProperties.SectionName)}" />
                        <StackPanel
                            x:Name="ShowcaseRoutedEventScope"
                            Margin="0,10,0,0"
                            local:ShowcaseRoutedEventButton.ShowcaseActivated="OnShowcaseRoutedEventScope">
                            <local:ShowcaseRoutedEventButton
                                x:Name="ShowcaseRoutedEventButton"
                                Content="Raise routed event"
                                ShowcaseActivated="OnShowcaseRoutedEventSource" />
                            <TextBlock
                                x:Name="ShowcaseRoutedEventStatusText"
                                Margin="0,6,0,0"
                                Text="Routed event idle" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,18,0,4"
                            FontWeight="SemiBold"
                            Text="Selected summary" />
                        <TextBlock
                            x:Name="SelectedItemSummaryText"
                            TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ShowcaseItemSummaryConverter}">
                                    <Binding Path="SelectedItem.Name" />
                                    <Binding Path="SelectedItem.Category" />
                                    <Binding Path="Progress" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Views">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox
                        x:Name="ActiveOnlyCheckBox"
                        Margin="0,0,0,12"
                        Checked="OnActiveOnlyFilterChanged"
                        Content="Show active items only"
                        IsChecked="{Binding ShowActiveOnly}"
                        Unchecked="OnActiveOnlyFilterChanged" />

                    <ListBox
                        x:Name="GroupedItemsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Source={StaticResource ItemsViewSource}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,8,0,4"
                                            Padding="6,3"
                                            Background="{DynamicResource ShowcasePanelBrush}">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        MinWidth="120"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        x:Name="GroupedItemActiveText"
                                        Foreground="#5B6472"
                                        Text="{Binding IsActive, Converter={StaticResource ShowcaseActiveTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Collection view" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="CollectionViewSource sorting, grouping, filtering, and group header templates are loaded from compiled WPF XAML." />
                            <TextBlock
                                Margin="0,14,0,6"
                                FontWeight="SemiBold"
                                Text="Formatted items" />
                            <ListBox
                                x:Name="FormattedItemsList"
                                AlternationCount="3"
                                ItemStringFormat="formatted {0}"
                                ItemsSource="{Binding FormattedItems}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bindings">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Binding fallback paths" />
                        <TextBlock
                            x:Name="PriorityBindingText"
                            Margin="0,0,0,8">
                            <TextBlock.Text>
                                <PriorityBinding FallbackValue="Priority fallback">
                                    <Binding Path="MissingPriorityText" />
                                    <Binding Path="SelectedItem.Name" />
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock
                            x:Name="FallbackBindingText"
                            Margin="0,0,0,8"
                            Text="{Binding MissingFallbackText, FallbackValue=Fallback binding text}" />
                        <TextBlock
                            x:Name="TargetNullBindingText"
                            Margin="0,0,0,8"
                            Text="{Binding NullDisplayText, TargetNullValue=Target null text}" />
                        <TextBlock
                            x:Name="BindingTargetUpdatedText"
                            Margin="0,0,0,8"
                            Binding.TargetUpdated="OnShowcaseBindingTargetUpdated"
                            Text="{Binding BindingTransferText, NotifyOnTargetUpdated=True}" />
                        <TextBox
                            x:Name="BindingSourceUpdatedTextBox"
                            Margin="0,0,0,8"
                            Binding.SourceUpdated="OnShowcaseBindingSourceUpdated"
                            Text="{Binding BindingTransferText, Mode=TwoWay, UpdateSourceTrigger=Explicit, NotifyOnSourceUpdated=True}" />
                        <TextBlock
                            x:Name="RelativeSelfBindingText"
                            Margin="0,0,0,8"
                            Tag="Self binding text"
                            Text="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
                        <Border
                            x:Name="RelativeAncestorBorder"
                            Padding="8"
                            Background="{DynamicResource ShowcasePanelBrush}"
                            Tag="Ancestor binding text">
                            <TextBlock
                                x:Name="RelativeAncestorBindingText"
                                Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=Tag}" />
                        </Border>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Binding engine" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses PriorityBinding, FallbackValue, TargetNullValue, binding transfer events, and RelativeSource bindings through SDK-built BAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Selectors">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox
                        x:Name="SelectorGroupBox"
                        Header="Selector container">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="SelectedValue selector" />
                            <ComboBox
                                x:Name="SelectedValueComboBox"
                                Grid.Row="1"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Items}"
                                SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                                SelectedValuePath="Category"
                                SelectionChanged="OnSelectorSelectionChanged" />

                            <ListBox
                                x:Name="MultiSelectItemsList"
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Items}"
                                ScrollViewer.CanContentScroll="True"
                                SelectionChanged="OnMultiSelectorSelectionChanged"
                                SelectionMode="Multiple"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <Expander
                        x:Name="SelectorExpander"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Collapsed="OnSelectorExpanderCollapsed"
                        Expanded="OnSelectorExpanderExpanded"
                        Header="Scrollable details"
                        IsExpanded="False">
                        <ScrollViewer
                            x:Name="SelectorScrollViewer"
                            Height="160"
                            HorizontalScrollBarVisibility="Disabled"
                            MouseWheel="OnSelectorScrollViewerMouseWheel"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    x:Name="SelectorScrollText"
                                    TextWrapping="Wrap"
                                    Text="This selector surface uses SelectedValuePath, multi-selection, GroupBox, Expander, and ScrollViewer from ordinary WPF XAML." />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Text="{Binding StatusText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Input">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ToolBarTray
                        x:Name="ShowcaseToolBarTray"
                        Grid.ColumnSpan="2">
                        <ToolBar
                            x:Name="ShowcaseToolBar"
                            Header="Showcase tools">
                            <Button
                                x:Name="ToolBarRefreshButton"
                                Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                                Content="Refresh">
                                <Button.ToolTip>
                                    <ToolTip
                                        x:Name="ToolBarRefreshToolTip"
                                        Placement="Bottom">
                                        <TextBlock
                                            x:Name="ToolBarRefreshToolTipText"
                                            Text="Refresh status command" />
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                            <Separator x:Name="ToolBarSeparator" />
                            <ToggleButton
                                x:Name="ToolBarToggleButton"
                                Checked="OnInputToggleChecked"
                                Content="Actions"
                                IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"
                                Unchecked="OnInputToggleUnchecked" />
                        </ToolBar>
                    </ToolBarTray>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Choice controls" />
                        <Button
                            x:Name="PopupOwnerButton"
                            Content="Popup owner" />
                        <primitives:Popup
                            x:Name="InputPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PopupOwnerButton}"
                            StaysOpen="False">
                            <Border
                                Padding="10"
                                Background="{DynamicResource ShowcasePanelBrush}"
                                BorderBrush="#B7C2D0"
                                BorderThickness="1">
                                <TextBlock
                                    x:Name="InputPopupText"
                                    Text="Popup content" />
                            </Border>
                        </primitives:Popup>
                        <ToggleButton
                            x:Name="InputToggleButton"
                            Margin="0,12,0,0"
                            Checked="OnInputToggleChecked"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"
                            Unchecked="OnInputToggleUnchecked" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <RadioButton
                                x:Name="FrameworkRadioButton"
                                GroupName="ShowcaseCategory"
                                Checked="OnCategoryRadioChecked"
                                Content="Framework"
                                IsChecked="True"
                                Tag="Framework" />
                            <RadioButton
                                x:Name="RenderingRadioButton"
                                Margin="14,0,0,0"
                                GroupName="ShowcaseCategory"
                                Checked="OnCategoryRadioChecked"
                                Content="Rendering"
                                Tag="Rendering" />
                        </StackPanel>
                        <RepeatButton
                            x:Name="InputRepeatButton"
                            Margin="0,14,0,0"
                            Click="OnInputRepeatButtonClick"
                            Content="Repeat action"
                            Delay="180"
                            Interval="70" />
                        <StackPanel
                            x:Name="InputThumbPanel"
                            Margin="0,14,0,0"
                            primitives:Thumb.DragDelta="OnInputBubbledThumbDragDelta">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="Thumb drag manager" />
                            <primitives:Thumb
                                x:Name="InputDragThumb"
                                Width="32"
                                Height="20"
                                HorizontalAlignment="Left"
                                DragStarted="OnInputThumbDragStarted"
                                DragDelta="OnInputThumbDragDelta"
                                DragCompleted="OnInputThumbDragCompleted"
                                Tag="showcase drag thumb" />
                            <TextBlock
                                x:Name="InputDragStatusText"
                                Margin="0,6,0,0"
                                Text="Drag idle" />
                        </StackPanel>
                        <Border
                            x:Name="ShowcaseDropTarget"
                            Margin="0,14,0,0"
                            MinHeight="42"
                            Padding="8"
                            AllowDrop="True"
                            Background="#FFFFFF"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            DragEnter="OnShowcaseDropTargetDragEnter"
                            DragOver="OnShowcaseDropTargetDragOver"
                            Drop="OnShowcaseDropTargetDrop"
                            PreviewDragEnter="OnShowcaseDropTargetPreviewDragEnter"
                            PreviewDragOver="OnShowcaseDropTargetPreviewDragOver"
                            PreviewDrop="OnShowcaseDropTargetPreviewDrop">
                            <TextBlock
                                x:Name="ShowcaseDropTargetText"
                                Text="Drop target idle" />
                        </Border>
                        <StackPanel
                            x:Name="KeyboardNavigationPanel"
                            Margin="0,16,0,0"
                            FocusManager.FocusedElement="{Binding ElementName=KeyboardNavigationFirstBox}"
                            FocusManager.IsFocusScope="True"
                            KeyboardNavigation.ControlTabNavigation="Cycle"
                            KeyboardNavigation.DirectionalNavigation="Contained"
                            KeyboardNavigation.TabNavigation="Cycle">
                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="Keyboard navigation" />
                            <Label
                                x:Name="KeyboardNavigationAccessLabel"
                                Content="_First focus target"
                                Target="{Binding ElementName=KeyboardNavigationFirstBox}" />
                            <TextBox
                                x:Name="KeyboardNavigationFirstBox"
                                TabIndex="0"
                                Text="First focus target" />
                            <Button
                                x:Name="KeyboardNavigationSecondButton"
                                Margin="0,8,0,0"
                                Content="Second focus target"
                                TabIndex="1" />
                            <TextBox
                                x:Name="KeyboardNavigationThirdBox"
                                Margin="0,8,0,0"
                                TabIndex="2"
                                Text="Third focus target" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,14,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Date controls" />
                        <Calendar
                            x:Name="InputCalendar"
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDatesChanged="OnInputDateSelectionChanged"
                            SelectionMode="SingleDate" />
                        <DatePicker
                            x:Name="InputDatePicker"
                            Margin="0,12,0,0"
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateChanged="OnInputDateSelectionChanged" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Layout">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel
                        x:Name="ShowcaseDockPanel"
                        MinHeight="92"
                        LastChildFill="True">
                        <Border
                            x:Name="DockTopBand"
                            DockPanel.Dock="Top"
                            Padding="8"
                            Background="{DynamicResource ShowcasePanelBrush}">
                            <TextBlock Text="Docked header" />
                        </Border>
                        <Border
                            x:Name="DockLeftBand"
                            Width="92"
                            DockPanel.Dock="Left"
                            Padding="8"
                            Background="#E7F5EE">
                            <TextBlock Text="Left dock" />
                        </Border>
                        <Border
                            x:Name="DockRightBand"
                            Width="92"
                            DockPanel.Dock="Right"
                            Padding="8"
                            Background="#F2F3F6">
                            <TextBlock Text="Right dock" />
                        </Border>
                        <TextBlock
                            x:Name="DockFillText"
                            Padding="8"
                            Text="Fill content" />
                    </DockPanel>

                    <WrapPanel
                        x:Name="ShowcaseWrapPanel"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        ItemHeight="28"
                        ItemWidth="90"
                        Orientation="Horizontal">
                        <Button Content="One" />
                        <Button Content="Two" />
                        <Button Content="Three" />
                    </WrapPanel>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,14,0,0">
                        <UniformGrid
                            x:Name="ShowcaseUniformGrid"
                            Columns="3"
                            FirstColumn="1"
                            Rows="2">
                            <TextBlock Text="Alpha" />
                            <TextBlock Text="Beta" />
                            <TextBlock Text="Gamma" />
                        </UniformGrid>

                        <Canvas
                            x:Name="ShowcaseShapeCanvas"
                            Width="260"
                            Height="132"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Background="#F8FAFC">
                            <Rectangle
                                x:Name="ShowcaseShapeRectangle"
                                Width="72"
                                Height="44"
                                Canvas.Left="12"
                                Canvas.Top="12"
                                Fill="#2F80ED"
                                RadiusX="6"
                                RadiusY="6"
                                Stroke="#1455A3"
                                StrokeThickness="2" />
                            <Ellipse
                                x:Name="ShowcaseShapeEllipse"
                                Width="54"
                                Height="54"
                                Canvas.Left="104"
                                Canvas.Top="16"
                                Fill="#E7F5EE"
                                Stroke="#236B46"
                                StrokeThickness="3" />
                            <Line
                                x:Name="ShowcaseShapeLine"
                                Stroke="#A855F7"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="4"
                                X1="16"
                                X2="154"
                                Y1="98"
                                Y2="76" />
                            <Path
                                x:Name="ShowcaseShapePath"
                                Canvas.Left="178"
                                Canvas.Top="20"
                                Data="M 0,40 L 24,0 L 48,40 Z"
                                Fill="#FFB020"
                                Stroke="#7C4A00"
                                StrokeThickness="2" />
                        </Canvas>
                    </StackPanel>

                    <Grid
                        x:Name="ShowcaseGridSplitterGrid"
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                x:Name="SplitterLeftColumn"
                                Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition
                                x:Name="SplitterRightColumn"
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="SplitterLeftPane"
                            Padding="8"
                            Background="{DynamicResource ShowcasePanelBrush}">
                            <TextBlock Text="Left pane" />
                        </Border>
                        <GridSplitter
                            x:Name="ShowcaseGridSplitter"
                            Grid.Column="1"
                            Width="6"
                            HorizontalAlignment="Stretch"
                            KeyboardIncrement="12"
                            ResizeBehavior="PreviousAndNext"
                            ShowsPreview="False"
                            VerticalAlignment="Stretch" />
                        <Border
                            x:Name="SplitterRightPane"
                            Grid.Column="2"
                            Padding="8"
                            Background="#F2F3F6">
                            <TextBlock Text="Right pane" />
                        </Border>

                        <Viewbox
                            x:Name="ShowcaseViewbox"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,14,0,0"
                            MaxHeight="54"
                            Stretch="Uniform">
                            <TextBlock
                                x:Name="ViewboxText"
                                FontSize="20"
                                Text="Scaled layout content" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Resources">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="ComponentResourceText"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type local:MainWindow}, ResourceId=ShowcaseComponentAccentBrush}}"
                            Text="Component resource brush" />
                        <TextBlock
                            x:Name="LocalizedResourceText"
                            x:Uid="ShowcaseLocalizedResourceText"
                            Margin="0,12,0,0"
                            Localization.Attributes="$Text (Readable Modifiable Text)"
                            Localization.Comments="$Text (Showcase localization comment)"
                            Text="Localized resource metadata" />
                        <AccessText
                            x:Name="ResourceAccessText"
                            Margin="0,12,0,0"
                            Text="_Resource access key" />
                        <TextBlock
                            x:Name="ObjectProviderText"
                            Margin="0,12,0,0"
                            Text="{Binding Source={StaticResource ShowcaseObjectDataProvider}}" />
                        <TextBlock
                            x:Name="XmlProviderText"
                            Margin="0,12,0,0"
                            Text="{Binding Source={StaticResource ShowcaseXmlDataProvider}, XPath=@name}" />
                        <ItemsControl
                            x:Name="ResourceArrayItemsControl"
                            Margin="0,12,0,0"
                            ItemsSource="{StaticResource ShowcaseStringArray}" />
                        <ItemsControl
                            x:Name="ResourceCompositeItemsControl"
                            Margin="0,12,0,0"
                            ItemsSource="{StaticResource ShowcaseCompositeCollection}" />
                        <TextBlock
                            x:Name="NullIntrinsicText"
                            Margin="0,12,0,0"
                            Tag="{x:Null}"
                            Text="Null intrinsic target" />
                        <TextBlock
                            x:Name="MarkupExtensionText"
                            Margin="0,12,0,0"
                            Text="{local:ShowcaseText Prefix=Markup, Value=Extension}" />
                        <TextBlock
                            x:Name="PackResourceText"
                            Margin="0,12,0,0"
                            Text="Pack resource loaded from Assets/ShowcaseResource.txt" />
                        <TextBlock
                            x:Name="ComponentPackResourceText"
                            Margin="0,12,0,0"
                            Style="{StaticResource ShowcaseComponentPackTextStyle}"
                            Text="{StaticResource ShowcaseComponentPackText}" />
                        <TextBlock
                            x:Name="StartupResourceText"
                            Margin="0,12,0,0"
                            Foreground="{DynamicResource ShowcaseStartupBrush}"
                            Text="{DynamicResource ShowcaseStartupText}" />
                        <TextBlock
                            x:Name="SystemParameterText"
                            Margin="0,12,0,0"
                            Text="{Binding Source={x:Static SystemParameters.PrimaryScreenWidth}, StringFormat=Primary screen width: {0}}" />
                        <TextBlock
                            x:Name="SystemFontText"
                            Margin="0,12,0,0"
                            FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                            FontSize="{x:Static SystemFonts.MessageFontSize}"
                            Text="System font sample" />
                        <Border
                            x:Name="SystemColorBorder"
                            Margin="0,12,0,0"
                            Padding="6"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="1">
                            <TextBlock
                                x:Name="SystemColorText"
                                Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                Text="System color sample" />
                        </Border>
                        <local:ShowcaseThemedControl
                            x:Name="ShowcaseThemedControl"
                            Margin="0,12,0,0"
                            Text="Generic theme default style" />
                        <StackPanel
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <Image
                                x:Name="ShowcaseDrawingImageControl"
                                Width="36"
                                Height="36"
                                Source="{StaticResource ShowcaseDrawingImage}"
                                Stretch="Uniform" />
                            <Border
                                x:Name="ShowcaseDrawingImageBrushBorder"
                                Width="36"
                                Height="36"
                                Margin="10,0,0,0"
                                Background="{StaticResource ShowcaseDrawingImageBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="ResourceDynamicBorder"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Resources" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses ComponentResourceKey, localization metadata, AccessText, SystemParameters, SystemColors, SystemFonts, DynamicResource invalidation, and a WPF Resource pack URI through SDK-built output." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Explorer">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TreeView
                        x:Name="NodesTreeView"
                        ItemTemplate="{StaticResource ShowcaseNodeTemplate}"
                        ItemsSource="{Binding Nodes}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,8"
                        FontWeight="SemiBold"
                        Text="Grid view" />

                    <ListView
                        x:Name="ExplorerListView"
                        Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                                <GridViewColumn
                                    Width="130"
                                    DisplayMemberBinding="{Binding Category}"
                                    Header="Category" />
                                <GridViewColumn
                                    Width="80"
                                    DisplayMemberBinding="{Binding IsActive}"
                                    Header="Active" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource ShowcasePanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Hierarchy" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="TreeView, HierarchicalDataTemplate, ListView, and GridView are loaded from normal WPF XAML through the ProGPU SDK." />
                            <TextBlock
                                Margin="0,14,0,6"
                                FontWeight="SemiBold"
                                Text="Explicit tree events" />
                            <TreeView
                                x:Name="ExplicitExplorerTreeView"
                                MinHeight="92">
                                <TreeViewItem
                                    x:Name="ExplicitExplorerAlpha"
                                    Collapsed="OnExplicitExplorerTreeCollapsed"
                                    Expanded="OnExplicitExplorerTreeExpanded"
                                    Header="Alpha branch"
                                    Selected="OnExplicitExplorerTreeSelected"
                                    Unselected="OnExplicitExplorerTreeUnselected">
                                    <TreeViewItem
                                        x:Name="ExplicitExplorerAlphaChild"
                                        Header="Alpha child" />
                                </TreeViewItem>
                                <TreeViewItem
                                    x:Name="ExplicitExplorerBeta"
                                    Header="Beta branch"
                                    Selected="OnExplicitExplorerTreeSelected"
                                    Unselected="OnExplicitExplorerTreeUnselected" />
                            </TreeView>
                            <TextBlock
                                x:Name="ExplicitExplorerTreeStatusText"
                                Margin="0,6,0,0"
                                Text="Tree idle"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Templates">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="SelectedItemContent"
                            Content="{Binding SelectedItem}"
                            ContentTemplate="{StaticResource SelectedItemTemplate}" />
                        <ContentControl
                            x:Name="ImplicitTemplateContent"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Content="{Binding SelectedItem}" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,14,0,8"
                            FontWeight="SemiBold"
                            Text="Template selector list" />

                        <ListBox
                            x:Name="SelectorItemsList"
                            Grid.Row="3"
                            ItemContainerStyle="{StaticResource ShowcaseSelectorItemContainerStyle}"
                            ItemTemplateSelector="{StaticResource ShowcaseItemTemplateSelector}"
