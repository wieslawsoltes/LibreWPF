<Project Sdk="LibreWPF.Sdk/0.1.0-preview.70">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ProGpuWpfSdkSampleTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <ProGpuWpfRendererMode>NativeMilWgpu</ProGpuWpfRendererMode>
    <ProGpuWpfNativeMilHitTesting>true</ProGpuWpfNativeMilHitTesting>
    <ProGpuWpfDx12ShaderCompiler Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == 'win-x64'">Dxc</ProGpuWpfDx12ShaderCompiler>
    <DefineConstants>$(DefineConstants);LIBREWPF_MODAL_PORTABLE</DefineConstants>
  </PropertyGroup>
</Project>
