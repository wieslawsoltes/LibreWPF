<Window
    x:Class="ProGPU.Wpf.SciChartApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootWindow"
    Title="ProGPU WPF SciChart Showcase"
    Width="920"
    Height="560"
    MinWidth="820"
    MinHeight="460">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SciChartShowcaseSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel
            Margin="18,14,18,10"
            LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Text="ProGPU WPF SciChart Showcase" />
                <TextBlock
                    x:Name="SubtitleText"
                    Margin="0,3,0,0"
                    Foreground="#6A7280"
                    Text="2D and 3D chart primitives rendered through ProGPU.DirectX" />
            </StackPanel>
            <Button
                x:Name="RenderButton"
                DockPanel.Dock="Right"
                Click="OnRenderButtonClick"
                Content="Render" />
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="18,0,18,12"
            Padding="16"
            Background="White"
            BorderBrush="#D3DAE6"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontWeight="SemiBold"
                    Text="Visual Xccelerator-style 2D bridge" />
                <TextBlock
                    Grid.Column="1"
                    Margin="18,0,0,0"
                    FontWeight="SemiBold"
                    Text="DirectX-style 3D bridge" />

                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Background="#111722"
                    BorderBrush="#202A38"
                    BorderThickness="1"
                    ClipToBounds="True">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <Image
                            x:Name="ChartImage"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            SnapsToDevicePixels="True"
                            Stretch="None" />
                    </ScrollViewer>
                </Border>

                <TextBlock
                    x:Name="RealSciChartLabel"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    FontWeight="SemiBold"
                    Text="Real SciChart package Showcase"
                    Visibility="Collapsed" />

                <ContentControl
                    x:Name="RealSciChartHost"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    MinHeight="170"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DrawCountText" Text="Draws: 0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="BackendText" Text="Backend: pending" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
