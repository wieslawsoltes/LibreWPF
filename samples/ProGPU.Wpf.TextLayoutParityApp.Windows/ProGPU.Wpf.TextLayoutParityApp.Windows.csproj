    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>ProGPU.Wpf.TextLayoutParityApp.Windows</AssemblyName>
    <RootNamespace>ProGPU.Wpf.TextLayoutParityApp</RootNamespace>
