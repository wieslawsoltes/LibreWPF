<Page
    x:Class="ProGPU.Wpf.RealXamlCompilerHarness.SmokePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="compiled source page">
    <StackPanel x:Name="SourceNavigationPagePanel">
        <TextBlock
            x:Name="SourceNavigationPageText"
            Tag="source page content"
            Text="compiled source page content" />
        <Button
            x:Name="SourceNavigationPageButton"
            Click="OnPageButtonClick"
            Content="compiled page button"
            Tag="source page button" />
    </StackPanel>
</Page>
