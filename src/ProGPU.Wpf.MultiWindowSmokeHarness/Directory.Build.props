       builds as an ordinary SDK project so its dependencies are copied next to it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworkVersion>10.0</TargetFrameworkVersion>
  </PropertyGroup>
</Project>
