<Project>
  <PropertyGroup>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/wieslawsoltes/wpf</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/wieslawsoltes/wpf</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworkVersion>10.0</TargetFrameworkVersion>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.42</VersionSuffix>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.1.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.1.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">Aligns LibreWPF preview.42 with immutable ProGPU preview.49 and exposes WebGPU adapter-selection diagnostics for native, external, browser-hosted, and shared contexts; retains exact transformed, dashed, fixed-width, shader-backed, and hairline stroke replay, adaptive device-error curve subdivision, allocation-free indexed stroke recording, and preserved DXF cosmetic strokes without a bridge workaround; preserves the typed, zero-allocation ProGPU media drawing-state bridge, native activation, deterministic popup-local input, transparent X11/XWayland visuals, and nonactivating windows; bounds retained render-resource caches and suppresses static-frame GPU rendering; and retains native Cocoa popups, Windows OLE clipboard, seven-theme, WPFGallery, and SharpDevelop designer acceptance gates.</PackageReleaseNotes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>
</Project>
